[
  {"type":"vocab_choice","content":"元音字母 A 的发音类似于中文的哪个音？","options":[{"text":"啊 (a)","is_correct":true},{"text":"一 (i)","is_correct":false},{"text":"乌 (u)","is_correct":false},{"text":"哦 (o)","is_correct":false}],"explanation":"元音字母 A 发音为宽开口的 [a] 音，类似于中文的啊。"},
  {"type":"vocab_choice","content":"元音字母 I 的发音类似于中文的哪个音？","options":[{"text":"衣 (i)","is_correct":true},{"text":"啊 (a)","is_correct":false},{"text":"五 (u)","is_correct":false},{"text":"额 (e)","is_correct":false}],"explanation":"元音字母 I 发音为 [i]，类似于中文的衣/一。"},
  {"type":"vocab_choice","content":"元音字母 U 的发音类似于中文的哪个音？","options":[{"text":"乌 (u)","is_correct":true},{"text":"哦 (o)","is_correct":false},{"text":"一 (i)","is_correct":false},{"text":"啊 (a)","is_correct":false}],"explanation":"元音字母 U 发音为圆唇的 [u]，类似于中文的乌/五。"},
  {"type":"vocab_choice","content":"元音字母 O 的发音类似于中文的哪个音？","options":[{"text":"哦 (o)","is_correct":true},{"text":"啊 (a)","is_correct":false},{"text":"额 (e)","is_correct":false},{"text":"衣 (i)","is_correct":false}],"explanation":"元音字母 O 发半开后双唇圆音 [o]，类似于中文的哦。"},
  {"type":"vocab_choice","content":"元音字母 E 在单词 besar (大) 中的发音是什么？","options":[{"text":"模糊音 [e] 如额","is_correct":true},{"text":"开口音 [e] 如哎","is_correct":false},{"text":"闭口音 [i]","is_correct":false},{"text":"不发音","is_correct":false}],"explanation":"字母 E 有两种主要发音，在 besar 中发中央元音 [e]（模糊元音），类似于中文额的轻读。"},
  {"type":"vocab_choice","content":"元音字母 E 在单词 sate (烤肉串) 中的发音是什么？","options":[{"text":"半闭元音 [e] 类似于哎","is_correct":true},{"text":"模糊元音 [e]","is_correct":false},{"text":"发乌音","is_correct":false},{"text":"发哦音","is_correct":false}],"explanation":"在 sate 中，字母 E 发半闭前元音 [e]，类似于中文的哎。"},
  {"type":"vocab_choice","content":"印尼语中一共有多少个字母？","options":[{"text":"26个","is_correct":true},{"text":"28个","is_correct":false},{"text":"24个","is_correct":false},{"text":"21个","is_correct":false}],"explanation":"印尼语使用的是26个标准英文字母（A 到 Z）。"},
  {"type":"vocab_choice","content":"下列哪个字母是元音字母？","options":[{"text":"I","is_correct":true},{"text":"B","is_correct":false},{"text":"K","is_correct":false},{"text":"S","is_correct":false}],"explanation":"印尼语的元音字母包括 A, I, U, E, O。"},
  {"type":"vocab_choice","content":"下列哪个字母不是元音字母？","options":[{"text":"G","is_correct":true},{"text":"A","is_correct":false},{"text":"U","is_correct":false},{"text":"I","is_correct":false}],"explanation":"元音字母是 A, I, U, E, O，其余为辅音（子音）。"},
  {"type":"vocab_choice","content":"单词 teras 在表示阳台时，字母 E 的发音是？","options":[{"text":"开口音 [e] 类似于哎","is_correct":true},{"text":"模糊音 [e] 类似于额","is_correct":false},{"text":"发一音","is_correct":false},{"text":"不发音","is_correct":false}],"explanation":"teras 表示阳台时，E 发 [e]（类似哎）；表示核心/重要时，E 发模糊音（类似额）。"},
  {"type":"vocab_choice","content":"印尼语字母 C 的发音类似中文的哪个音？","options":[{"text":"这 (che)","is_correct":true},{"text":"思 (si)","is_correct":false},{"text":"科 (ke)","is_correct":false},{"text":"比 (bi)","is_correct":false}],"explanation":"印尼语字母 C 发 [tS] 音，类似于中文的这（che）。"},
  {"type":"vocab_choice","content":"印尼语字母 G 的发音是哪种？","options":[{"text":"浊辅音 [g]，如英语 go","is_correct":true},{"text":"清辅音 [k]","is_correct":false},{"text":"擦音 [x]","is_correct":false},{"text":"鼻音 [ng]","is_correct":false}],"explanation":"印尼语 G 发浊辅音 [g]，发音时声带振动，如英语单词 go 中的 g。"},
  {"type":"vocab_choice","content":"双字母 NG 在印尼语中发什么音？","options":[{"text":"鼻音 [ng]（如 ing 结尾）","is_correct":true},{"text":"硬 G 音","is_correct":false},{"text":"鼻音 [n]","is_correct":false},{"text":"[nk] 音","is_correct":false}],"explanation":"印尼语 NG 发软腭鼻音 [ng]，类似英语 sing 结尾的 ng。"},
  {"type":"vocab_choice","content":"双字母 NY 在印尼语中发什么音？","options":[{"text":"腭化鼻音，类似中文的你","is_correct":true},{"text":"[n] + [j] 分开发音","is_correct":false},{"text":"[ni] 音","is_correct":false},{"text":"鼻音 [m]","is_correct":false}],"explanation":"印尼语 NY 发腭鼻音，类似中文的你（ni）里的声母。"},
  {"type":"vocab_choice","content":"双字母 SY 在印尼语中发什么音？","options":[{"text":"摩擦音，如英语 she","is_correct":true},{"text":"[s] + [j] 分开发音","is_correct":false},{"text":"[si] 音","is_correct":false},{"text":"清音 [s]","is_correct":false}],"explanation":"印尼语 SY 发摩擦音，类似英语 she 中的 sh。"},
  {"type":"vocab_choice","content":"印尼语字母 R 的发音特点是？","options":[{"text":"颤音，舌尖多次弹动","is_correct":true},{"text":"与英语 R 相同","is_correct":false},{"text":"发鼻音","is_correct":false},{"text":"不发音","is_correct":false}],"explanation":"印尼语 R 是颤音（弹舌音），舌尖在上颚快速弹动，类似西班牙语的 r。"},
  {"type":"vocab_choice","content":"印尼语单词末尾的 K 的发音特点是？","options":[{"text":"不完全爆破，类似喉音塞音","is_correct":true},{"text":"与词首 K 发音相同","is_correct":false},{"text":"完全不发音","is_correct":false},{"text":"发成 [g]","is_correct":false}],"explanation":"印尼语词末的 K 是未释放的塞音，气流被阻断但不发出完整爆破。"},
  {"type":"vocab_choice","content":"印尼语字母 F 的发音与哪个字母相同？","options":[{"text":"英语 F（唇齿清摩擦音）","is_correct":true},{"text":"V（唇齿摩擦音）","is_correct":false},{"text":"P（双唇塞音）","is_correct":false},{"text":"B（双唇浊塞音）","is_correct":false}],"explanation":"印尼语 F 发清唇齿摩擦音 [f]，与英语 F 相同。"},
  {"type":"vocab_choice","content":"印尼语字母 J 发什么音？","options":[{"text":"[dZ]，类似英语 jog 或中文贼","is_correct":true},{"text":"[j]，类似中文的也","is_correct":false},{"text":"[g]","is_correct":false},{"text":"[z]","is_correct":false}],"explanation":"印尼语 J 发 [dZ] 音（类似英语 jog 或中文贼），而不是 [j]。"},
  {"type":"vocab_choice","content":"以下哪个印尼语词汇的意思是空调？","options":[{"text":"AC","is_correct":true},{"text":"APD","is_correct":false},{"text":"HP","is_correct":false},{"text":"KTP","is_correct":false}],"explanation":"AC 在印尼语中是 Air Conditioner（空调）的缩写。"},
  {"type":"vocab_choice","content":"印尼语 apa 是什么意思？","options":[{"text":"什么","is_correct":true},{"text":"谁","is_correct":false},{"text":"哪里","is_correct":false},{"text":"为什么","is_correct":false}],"explanation":"apa 是印尼语疑问词，意为什么，如 Apa ini?（这是什么？）"},
  {"type":"vocab_choice","content":"以下哪组是正确的印尼语元音字母组合？","options":[{"text":"A, I, U, E, O","is_correct":true},{"text":"A, E, I, O, U, W","is_correct":false},{"text":"A, E, I, O","is_correct":false},{"text":"A, I, O, U, Y","is_correct":false}],"explanation":"印尼语有5个元音字母：A, I, U, E, O。"},
  {"type":"vocab_choice","content":"印尼语字母 W 发什么音？","options":[{"text":"半元音 [w]，类似英语 well 的起音","is_correct":true},{"text":"唇齿摩擦音 [v]","is_correct":false},{"text":"圆唇 [u]","is_correct":false},{"text":"双唇塞音 [b]","is_correct":false}],"explanation":"印尼语 W 发半元音 [w]，类似英语单词 well, water 的起始音。"},
  {"type":"vocab_choice","content":"印尼语 apakah 用于什么语境？","options":[{"text":"提问……吗？（一般疑问句）","is_correct":true},{"text":"感叹句","is_correct":false},{"text":"命令句","is_correct":false},{"text":"否定句","is_correct":false}],"explanation":"Apakah 放句首，构成一般疑问句，如 Apakah ini milik kamu?（这是你的吗？）"},
  {"type":"vocab_choice","content":"印尼语字母 H 在单词末尾时如何发音？","options":[{"text":"仍然发轻微摩擦音 [h]，不省略","is_correct":true},{"text":"完全不发音","is_correct":false},{"text":"发成 [k]","is_correct":false},{"text":"发成 [g]","is_correct":false}],"explanation":"印尼语 H 无论在词首、词中还是词末都需发出，只是末尾时气流较弱。"},
